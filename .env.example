# Server-only secrets: never prefix them with NEXT_PUBLIC_
DATABASE_URL=postgresql://user:password@localhost:5432/streetstar
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional — add only after verifying a StreetStar-owned sender domain
# RESEND_API_KEY=re_secret_value
# STREETSTAR_FROM_EMAIL=notifications@verified-streetstar-domain.example
# NEXT_PUBLIC_SITE_URL=https://your-streetstar-domain.example
